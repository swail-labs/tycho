            "status": "completed",
            "input": {
              "filePath": "/repo/tycho/opencode.py",
              "oldString": "def run(session_id: str, repo: Path) -> str | None:\n    \"\"\"Export one OpenCode session and return its Tycho report, failing open.\"\"\"\n    executable = shutil.which(\"opencode\") or Path.home() / \".opencode\" / \"bin\" / \"opencode\"\n    if not Path(executable).is_file():\n        return None\n    try:\n        exported = subprocess.run(\n            [executable, \"export\", session_id],\n            cwd=repo,\n            check=True,\n            capture_output=True,\n            text=True,\n        ).stdout\n        with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", encoding=\"utf-8\") as transcript:\n            transcript.write(exported)\n            transcript.flush()\n            session = engine.gather(Path(transcript.name), repo, parse=parse_opencode)\n        if not engine.has_verifiable_activity(session):\n            return None\n        results = engine.run_checks(session)\n        return render(engine.verdict_of(results), results)\n    except (OSError, ValueError, subprocess.SubprocessError):\n        return None",
              "newString": "def run(session_id: str, repo: Path) -> str | None:\n    \"\"\"Export one OpenCode session and return its Tycho report, failing open.\n\n    Unlike Claude/Cursor/Codex hooks (which fire only after tool use), OpenCode's\n    ``session.idle`` fires after *every* turn \u2014 including text-only turns where no\n    tools ran.  So we always run checks and render a verdict; when nothing happened\n    every check will honestly report UNSUPPORTED.\n    \"\"\"\n    executable = shutil.which(\"opencode\") or Path.home() / \".opencode\" / \"bin\" / \"opencode\"\n    if not Path(executable).is_file():\n        return None\n    try:\n        exported = subprocess.run(\n            [executable, \"export\", session_id],\n            cwd=repo,\n            check=True,\n            capture_output=True,\n            text=True,\n        ).stdout\n        with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", encoding=\"utf-8\") as transcript:\n            transcript.write(exported)\n            transcript.flush()\n            session = engine.gather(Path(transcript.name), repo, parse=parse_opencode)\n        results = engine.run_checks(session)\n        return render(engine.verdict_of(results), results)\n    except (OSError, ValueError, subprocess.SubprocessError):\n        return None"
            },
